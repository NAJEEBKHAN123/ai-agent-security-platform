PROJECT_NAME="AI Agent Security Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-security-platform-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite for effortless local dev, easily swapped to PostgreSQL:
# e.g. postgresql://user:password@localhost:5432/ai_security_db
DATABASE_URL="sqlite:///./security_platform.db"

# Mock Mode (True = zero API cost mock responses, False = live LLM)
MOCK_MODE=True
OPENAI_API_KEY=""

# Allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
